<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="DynonWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Dynon USB Updater</property>
    <property name="default-width">820</property>
    <property name="default-height">860</property>
    <property name="width-request">360</property>
    <property name="height-request">480</property>
    <child>
      <object class="AdwToastOverlay" id="toasts">
        <child>
          <object class="AdwToolbarView">
            <property name="top-bar-style">raised-border</property>
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="title-widget">
                  <object class="AdwWindowTitle" id="window_title">
                    <property name="title" translatable="yes">Dynon USB Updater</property>
                  </object>
                </property>
                <child type="start">
                  <object class="GtkMenuButton" id="menu_button">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="primary">true</property>
                    <property name="tooltip-text" translatable="yes">Main Menu</property>
                    <accessibility><property name="label" translatable="yes">Main menu</property></accessibility>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="AdwViewStack" id="stack">

                <!-- ============================ PREPARE ============================ -->
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">prepare</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">720</property>
                            <property name="tightening-threshold">560</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">24</property>
                                <property name="margin-top">24</property>
                                <property name="margin-bottom">32</property>
                                <property name="margin-start">24</property>
                                <property name="margin-end">24</property>

                                <child>
                                  <object class="AdwBanner" id="banner">
                                    <property name="revealed">false</property>
                                  </object>
                                </child>

                                <child>
                                  <object class="AdwPreferencesGroup" id="sources_group">
                                    <property name="title" translatable="yes">Update Files</property>
                                    <property name="header-suffix">
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <property name="valign">center</property>
                                        <child>
                                          <object class="GtkLabel" id="source_path">
                                            <property name="ellipsize">start</property>
                                            <property name="max-width-chars">24</property>
                                            <style><class name="caption"/><class name="dimmed"/></style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="change_folder">
                                            <property name="label" translatable="yes">Change…</property>
                                            <style><class name="flat"/></style>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                    <child>
                                      <object class="AdwActionRow" id="aviation_row">
                                        <property name="title" translatable="yes">Aviation Database</property>
                                        <property name="subtitle-lines">1</property>
                                        <child type="suffix">
                                          <object class="GtkLabel" id="aviation_cycle">
                                            <style><class name="heading"/><class name="accent"/></style>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkMenuButton" id="aviation_menu">
                                            <property name="icon-name">view-more-symbolic</property>
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">More options</property>
                                            <style><class name="flat"/></style>
                                            <accessibility><property name="label" translatable="yes">More options for the aviation database</property></accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="obstacle_row">
                                        <property name="title" translatable="yes">Obstacle Database</property>
                                        <property name="subtitle-lines">1</property>
                                        <child type="suffix">
                                          <object class="GtkLabel" id="obstacle_cycle">
                                            <style><class name="heading"/><class name="accent"/></style>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkMenuButton" id="obstacle_menu">
                                            <property name="icon-name">view-more-symbolic</property>
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">More options</property>
                                            <style><class name="flat"/></style>
                                            <accessibility><property name="label" translatable="yes">More options for the obstacle database</property></accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwActionRow" id="plates_row">
                                        <property name="title" translatable="yes">Approach Plates</property>
                                        <property name="subtitle-lines">1</property>
                                        <child type="suffix">
                                          <object class="AdwSpinner" id="plates_spinner">
                                            <property name="visible">false</property>
                                            <property name="valign">center</property>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkLabel" id="plates_cycle">
                                            <style><class name="heading"/><class name="accent"/></style>
                                          </object>
                                        </child>
                                        <child type="suffix">
                                          <object class="GtkMenuButton" id="plates_menu">
                                            <property name="icon-name">view-more-symbolic</property>
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">More options</property>
                                            <style><class name="flat"/></style>
                                            <accessibility><property name="label" translatable="yes">More options for the plates archive</property></accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Drives</property>
                                            <property name="hexpand">true</property>
                                            <property name="xalign">0</property>
                                            <style><class name="heading"/></style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="choose_folder">
                                            <property name="label" translatable="yes">Choose Folder…</property>
                                            <style><class name="flat"/></style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="rescan">
                                            <property name="icon-name">view-refresh-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Rescan drives</property>
                                            <style><class name="flat"/></style>
                                            <accessibility><property name="label" translatable="yes">Rescan drives</property></accessibility>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkStack" id="drives_stack">
                                        <property name="transition-type">crossfade</property>
                                        <property name="transition-duration">150</property>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">cards</property>
                                            <property name="child">
                                              <object class="GtkFlowBox" id="drive_flow">
                                                <property name="selection-mode">none</property>
                                                <property name="homogeneous">true</property>
                                                <property name="min-children-per-line">1</property>
                                                <property name="max-children-per-line">3</property>
                                                <property name="row-spacing">12</property>
                                                <property name="column-spacing">12</property>
                                                <property name="activate-on-single-click">false</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">empty</property>
                                            <property name="child">
                                              <object class="AdwStatusPage" id="drives_empty">
                                                <property name="icon-name">drive-removable-media-symbolic</property>
                                                <property name="vexpand">false</property>
                                                <property name="child">
                                                  <object class="GtkBox" id="drives_empty_actions">
                                                    <property name="spacing">12</property>
                                                    <property name="halign">center</property>
                                                  </object>
                                                </property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="halign">center</property>
                                    <property name="margin-top">8</property>
                                    <child>
                                      <object class="GtkButton" id="update_button">
                                        <property name="label" translatable="yes">Update Drives</property>
                                        <property name="sensitive">false</property>
                                        <property name="width-request">220</property>
                                        <style><class name="pill"/><class name="suggested-action"/></style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="reason_label">
                                        <property name="justify">center</property>
                                        <property name="wrap">true</property>
                                        <property name="max-width-chars">52</property>
                                        <style><class name="caption"/></style>
                                        <accessibility><property name="live">polite</property></accessibility>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- ============================ RUNNING ============================ -->
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">running</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">560</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                                <property name="valign">center</property>
                                <property name="margin-top">24</property>
                                <property name="margin-bottom">24</property>
                                <property name="margin-start">24</property>
                                <property name="margin-end">24</property>
                                <child>
                                  <object class="GtkLabel" id="percent_label">
                                    <property name="label">—</property>
                                    <style><class name="title-1"/><class name="numeric"/></style>
                                    <accessibility><property name="hidden">true</property></accessibility>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkProgressBar" id="progress">
                                    <property name="hexpand">true</property>
                                    <accessibility><property name="label" translatable="yes">Update progress</property></accessibility>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="step_label">
                                    <property name="wrap">true</property>
                                    <property name="justify">center</property>
                                    <style><class name="title-4"/></style>
                                    <accessibility><property name="live">polite</property></accessibility>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="detail_label">
                                    <style><class name="body"/><class name="dimmed"/><class name="numeric"/></style>
                                    <accessibility><property name="hidden">true</property></accessibility>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="eta_label">
                                    <style><class name="caption"/><class name="dimmed"/><class name="numeric"/></style>
                                    <accessibility><property name="hidden">true</property></accessibility>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPreferencesGroup" id="running_drives">
                                    <property name="margin-top">12</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPreferencesGroup">
                                    <child>
                                      <object class="AdwExpanderRow" id="details_row">
                                        <property name="title" translatable="yes">Details</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="cancel_button">
                                    <property name="label" translatable="yes">Cancel</property>
                                    <property name="halign">center</property>
                                    <property name="margin-top">12</property>
                                    <style><class name="pill"/></style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- ============================= RESULT ============================= -->
                <child>
                  <object class="AdwViewStackPage">
                    <property name="name">result</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">560</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="result_page">
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">24</property>
                                    <child>
                                      <object class="AdwPreferencesGroup" id="result_drives"/>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="result_actions">
                                        <property name="spacing">12</property>
                                        <property name="halign">center</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwPreferencesGroup">
                                        <child>
                                          <object class="AdwExpanderRow" id="result_details_row">
                                            <property name="title" translatable="yes">Details</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
